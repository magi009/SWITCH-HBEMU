diff --git a/src/dynarmic/src/dynarmic/backend/arm64/horizon_code_block.cpp b/src/dynarmic/src/dynarmic/backend/arm64/horizon_code_block.cpp
new file mode 100644
index 0000000..d33116b
--- /dev/null
+++ b/src/dynarmic/src/dynarmic/backend/arm64/horizon_code_block.cpp
@@ -0,0 +1,74 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Único archivo de Dynarmic que incluye libounce/kaiHEN. Ver horizon_code_block.h.
+
+#include "dynarmic/backend/arm64/horizon_code_block.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <new>
+
+#include <switch.h>
+#include <kaihen.h>
+
+namespace Dynarmic::Backend::Arm64 {
+
+static_assert(sizeof(HorizonCodeBlock::Range) == sizeof(KaihenJitRange));
+static_assert(offsetof(HorizonCodeBlock::Range, offset) == offsetof(KaihenJitRange, offset));
+static_assert(offsetof(HorizonCodeBlock::Range, size) == offsetof(KaihenJitRange, size));
+
+struct HorizonCodeBlock::Impl {
+    Jit jit{};
+};
+
+HorizonCodeBlock::HorizonCodeBlock(std::size_t size)
+        : m_impl{std::make_unique<Impl>()}, m_size{size} {
+    if (R_FAILED(jitCreate(&m_impl->jit, size))) {
+        throw std::bad_alloc{};
+    }
+    m_w = static_cast<std::uint32_t*>(jitGetRwAddr(&m_impl->jit));
+    m_x = static_cast<std::uint32_t*>(jitGetRxAddr(&m_impl->jit));
+    m_dirty.reserve(64);
+}
+
+HorizonCodeBlock::~HorizonCodeBlock() {
+    jitClose(&m_impl->jit);
+}
+
+void HorizonCodeBlock::invalidate_all() {
+    m_dirty.clear();
+    m_dirty.push_back(Range{0, m_size});
+    Publish();
+}
+
+void HorizonCodeBlock::Publish() {
+    if (m_dirty.empty()) {
+        return;
+    }
+    // kaiHEN funde rangos adyacentes, pero ordenar y unir solapes aquí reduce
+    // los bytes por IPC cuando un mismo bloque se re-enlaza varias veces.
+    std::sort(m_dirty.begin(), m_dirty.end(),
+              [](const Range& a, const Range& b) { return a.offset < b.offset; });
+    std::size_t out = 0;
+    for (std::size_t i = 1; i < m_dirty.size(); ++i) {
+        Range& last = m_dirty[out];
+        const Range& cur = m_dirty[i];
+        if (cur.offset <= last.offset + last.size) {
+            last.size = std::max(last.offset + last.size, cur.offset + cur.size) - last.offset;
+        } else {
+            m_dirty[++out] = cur;
+        }
+    }
+    m_dirty.resize(out + 1);
+
+    const Result rc = kaihenJitPublishRanges(
+        &m_impl->jit, reinterpret_cast<const KaihenJitRange*>(m_dirty.data()), m_dirty.size());
+    if (R_FAILED(rc)) {
+        // Sin publicación el invitado ejecutaría código viejo: mejor abortar ya.
+        diagAbortWithResult(rc);
+    }
+    m_dirty.clear();
+}
+
+}  // namespace Dynarmic::Backend::Arm64
diff --git a/src/dynarmic/src/dynarmic/backend/arm64/horizon_code_block.h b/src/dynarmic/src/dynarmic/backend/arm64/horizon_code_block.h
new file mode 100644
index 0000000..5ca14c5
--- /dev/null
+++ b/src/dynarmic/src/dynarmic/backend/arm64/horizon_code_block.h
@@ -0,0 +1,87 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Bloque de código JIT para Switch 2 (libounce + kaiHEN).
+//
+// En Horizon un juego no puede mapear memoria RWX ni llamar a las syscalls de
+// code memory. kaiHEN resuelve el JIT con el proceso RO: jitCreate() devuelve
+// una vista RX estable (la que se ejecuta) y un búfer de staging RW que NO es
+// un alias físico de la RX. Lo escrito en staging solo se vuelve ejecutable al
+// publicarlo (kaihenJitPublishRanges), que copia los rangos a través del alias
+// que retiene RO, limpia la caché de datos e invalida la caché de
+// instrucciones del hilo que llama.
+//
+// Esta clase imita la interfaz de oaknut::CodeBlock que usa el backend arm64
+// de Dynarmic, separando wptr() (staging) de xptr() (RX):
+//   - invalidate(x, n) no toca cachés: anota el rango como sucio.
+//   - protect() publica todos los rangos sucios en una sola petición IPC.
+//   - unprotect() no hace nada: el staging siempre es escribible.
+//
+// Cada AddressSpace pertenece a un núcleo emulado y solo su propio hilo emite
+// y parchea código, así que nunca se modifica un bloque que otro hilo esté
+// ejecutando (requisito de kaiHEN).
+//
+// IMPORTANTE: este header NO incluye <switch.h>. libnx define macros (BIT, ...)
+// y tipos globales (u128, ...) que chocan con oaknut y Dynarmic; todo lo de
+// libounce vive en horizon_code_block.cpp.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace Dynarmic::Backend::Arm64 {
+
+class HorizonCodeBlock {
+public:
+    explicit HorizonCodeBlock(std::size_t size);
+    ~HorizonCodeBlock();
+
+    HorizonCodeBlock(const HorizonCodeBlock&) = delete;
+    HorizonCodeBlock& operator=(const HorizonCodeBlock&) = delete;
+    HorizonCodeBlock(HorizonCodeBlock&&) = delete;
+    HorizonCodeBlock& operator=(HorizonCodeBlock&&) = delete;
+
+    /// Dirección ejecutable (la que Dynarmic usa como CodePtr).
+    std::uint32_t* xptr() const { return m_x; }
+    /// Dirección escribible (staging).
+    std::uint32_t* wptr() const { return m_w; }
+    /// Compatibilidad con oaknut::CodeBlock::ptr(): devuelve la vista RX.
+    std::uint32_t* ptr() const { return m_x; }
+
+    void unprotect() {}
+    void protect() { Publish(); }
+
+    /// Marca como sucio [xmem, xmem + size) (direcciones de la vista RX).
+    void invalidate(std::uint32_t* xmem, std::size_t size) {
+        const auto begin = reinterpret_cast<std::uintptr_t>(xmem);
+        const auto base = reinterpret_cast<std::uintptr_t>(m_x);
+        if (size == 0 || begin < base || begin + size > base + m_size) {
+            return;
+        }
+        m_dirty.push_back(Range{begin - base, size});
+    }
+
+    /// Publica el búfer completo. Caro (copia m_size bytes): evitarlo en caliente.
+    void invalidate_all();
+
+    /// Mismo layout que KaihenJitRange (comprobado con static_assert en el .cpp).
+    struct Range {
+        std::uint64_t offset;
+        std::uint64_t size;
+    };
+
+private:
+    void Publish();
+
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+    std::size_t m_size;
+    std::uint32_t* m_w = nullptr;
+    std::uint32_t* m_x = nullptr;
+    std::vector<Range> m_dirty;
+};
+
+}  // namespace Dynarmic::Backend::Arm64
diff --git a/src/dynarmic/src/dynarmic/common/spin_lock_arm64.cpp b/src/dynarmic/src/dynarmic/common/spin_lock_arm64.cpp
index 7833b65..d63cf87 100644
--- a/src/dynarmic/src/dynarmic/common/spin_lock_arm64.cpp
+++ b/src/dynarmic/src/dynarmic/common/spin_lock_arm64.cpp
@@ -5,7 +5,9 @@
 
 #include <mutex>
 
+#ifndef __SWITCH2__
 #include <oaknut/code_block.hpp>
+#endif
 #include <oaknut/oaknut.hpp>
 
 #include "dynarmic/backend/arm64/abi.h"
@@ -35,6 +37,28 @@ void EmitSpinLockUnlock(oaknut::CodeGenerator& code, oaknut::XReg ptr) {
     code.STLR(WZR, ptr);
 }
 
+#ifdef __SWITCH2__
+
+// En Switch 2 no generamos el spinlock con JIT: un objeto estático no puede pedir
+// memoria a kaiHEN antes de que libounce haya inicializado sus servicios. Mismo
+// protocolo que el código emitido (0 = libre, 1 = tomado; adquirir/liberar).
+void SpinLock::Lock() noexcept {
+    for (;;) {
+        if (__atomic_exchange_n(&storage, 1, __ATOMIC_ACQUIRE) == 0) {
+            return;
+        }
+        while (__atomic_load_n(&storage, __ATOMIC_RELAXED) != 0) {
+            __asm__ volatile("yield");
+        }
+    }
+}
+
+void SpinLock::Unlock() noexcept {
+    __atomic_store_n(&storage, 0, __ATOMIC_RELEASE);
+}
+
+#else
+
 namespace {
 
 struct SpinLockImpl {
@@ -83,4 +107,6 @@ void SpinLock::Unlock() noexcept {
     impl.unlock(&storage);
 }
 
+#endif  // __SWITCH2__
+
 }  // namespace Dynarmic
