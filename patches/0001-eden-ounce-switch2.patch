+static_assert(Button::A == HidNpadButton_A && Button::B == HidNpadButton_B);
+static_assert(Button::X == HidNpadButton_X && Button::Y == HidNpadButton_Y);
+static_assert(Button::StickL == HidNpadButton_StickL && Button::StickR == HidNpadButton_StickR);
+static_assert(Button::L == HidNpadButton_L && Button::R == HidNpadButton_R);
+static_assert(Button::ZL == HidNpadButton_ZL && Button::ZR == HidNpadButton_ZR);
+static_assert(Button::Plus == HidNpadButton_Plus && Button::Minus == HidNpadButton_Minus);
+static_assert(Button::Left == HidNpadButton_Left && Button::Up == HidNpadButton_Up);
+static_assert(Button::Right == HidNpadButton_Right && Button::Down == HidNpadButton_Down);
+static_assert(Button::AnySL == HidNpadButton_AnySL && Button::AnySR == HidNpadButton_AnySR);
+
+void SetNoSuspend() {
+    appletSetFocusHandlingMode(AppletFocusHandlingMode_NoSuspend);
+}
+
+bool MainLoop() {
+    return appletMainLoop();
+}
+
+bool IsDocked() {
+    return appletGetOperationMode() == AppletOperationMode_Console;
+}
+
+bool IsInFocus() {
+    return appletGetFocusState() == AppletFocusState_InFocus;
+}
+
+void SleepNs(std::int64_t ns) {
+    svcSleepThread(ns);
+}
+
+std::uint64_t MonotonicNs() {
+    return armTicksToNs(armGetSystemTick());
+}
+
+void* DefaultWindow() {
+    return nwindowGetDefault();
+}
+
+bool GetWindowSize(std::uint32_t& width, std::uint32_t& height) {
+    u32 w = 0;
+    u32 h = 0;
+    if (R_FAILED(nwindowGetDimensions(nwindowGetDefault(), &w, &h)) || w == 0 || h == 0) {
+        return false;
+    }
+    width = w;
+    height = h;
+    return true;
+}
+
+namespace {
+std::array<PadState, MaxPads> g_pads{};
+
+float Normalize(s32 v) {
+    return static_cast<float>(v) / static_cast<float>(JOYSTICK_MAX);
+}
+} // namespace
+
+void InitPads() {
+    padConfigureInput(MaxPads, HidNpadStyleSet_NpadStandard);
+    // Mando 0 = portátil + jugador 1 (como padInitializeDefault); el resto, uno por jugador.
+    padInitializeDefault(&g_pads[0]);
+    for (int i = 1; i < MaxPads; ++i) {
+        padInitialize(&g_pads[i], static_cast<HidNpadIdType>(HidNpadIdType_No1 + i));
+    }
+}
+
+void PollPads(std::array<PadSnapshot, MaxPads>& out) {
+    for (int i = 0; i < MaxPads; ++i) {
+        PadState& pad = g_pads[i];
+        padUpdate(&pad);
+        PadSnapshot& snap = out[i];
+        snap.connected = padIsConnected(&pad);
+        if (!snap.connected) {
+            continue;
+        }
+        snap.buttons = padGetButtons(&pad);
+        const HidAnalogStickState l = padGetStickPos(&pad, 0);
+        const HidAnalogStickState r = padGetStickPos(&pad, 1);
+        snap.lx = Normalize(l.x);
+        snap.ly = Normalize(l.y);
+        snap.rx = Normalize(r.x);
+        snap.ry = Normalize(r.y);
+    }
+}
+
+} // namespace Ounce::Hos
diff --git a/src/eden_ounce/horizon.h b/src/eden_ounce/horizon.h
new file mode 100644
index 0000000..29c37f5
--- /dev/null
+++ b/src/eden_ounce/horizon.h
@@ -0,0 +1,64 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Capa de plataforma Horizon (libounce) para el frontend.
+//
+// libnx/libounce y Eden NO pueden compartir una unidad de compilación:
+//   - libnx define `struct Service` y Eden un `namespace Service`;
+//   - ambos definen `u128` con tipos distintos;
+//   - libnx define macros como BIT() que rompen oaknut.
+// Por eso solo horizon.cpp y launcher.cpp incluyen <switch.h>; el resto del
+// frontend (y todo Eden) habla con la consola únicamente a través de este header,
+// que solo usa tipos estándar.
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+
+namespace Ounce::Hos {
+
+// ------------------------------------------------------------------ applet
+void SetNoSuspend();     ///< Seguir emulando aunque el applet pierda el foco.
+bool MainLoop();         ///< appletMainLoop(): false si el sistema pide cerrar.
+bool IsDocked();         ///< true en modo TV/dock.
+bool IsInFocus();
+void SleepNs(std::int64_t ns);
+std::uint64_t MonotonicNs();
+
+// ------------------------------------------------------------------ vídeo
+void* DefaultWindow();   ///< NWindow* por defecto (para VK_NN_vi_surface).
+bool GetWindowSize(std::uint32_t& width, std::uint32_t& height);
+
+// ------------------------------------------------------------------ entrada
+/// Bits de botón con los mismos valores que HidNpadButton (comprobado en horizon.cpp).
+namespace Button {
+constexpr std::uint64_t A = 1ULL << 0, B = 1ULL << 1, X = 1ULL << 2, Y = 1ULL << 3;
+constexpr std::uint64_t StickL = 1ULL << 4, StickR = 1ULL << 5;
+constexpr std::uint64_t L = 1ULL << 6, R = 1ULL << 7, ZL = 1ULL << 8, ZR = 1ULL << 9;
+constexpr std::uint64_t Plus = 1ULL << 10, Minus = 1ULL << 11;
+constexpr std::uint64_t Left = 1ULL << 12, Up = 1ULL << 13, Right = 1ULL << 14, Down = 1ULL << 15;
+constexpr std::uint64_t LeftSL = 1ULL << 24, LeftSR = 1ULL << 25;
+constexpr std::uint64_t RightSL = 1ULL << 26, RightSR = 1ULL << 27;
+constexpr std::uint64_t AnySL = LeftSL | RightSL, AnySR = LeftSR | RightSR;
+} // namespace Button
+
+struct PadSnapshot {
+    bool connected = false;
+    std::uint64_t buttons = 0;
+    float lx = 0, ly = 0, rx = 0, ry = 0; ///< -1..1, Y positivo = arriba
+};
+constexpr int MaxPads = 8;
+
+void InitPads();
+void PollPads(std::array<PadSnapshot, MaxPads>& out);
+
+// ------------------------------------------------------------------ UI de texto (launcher.cpp)
+/// Selector de juegos sobre la consola de libounce. Devuelve "" si el usuario sale.
+/// Libera el NWindow al terminar, para que Vulkan pueda usarlo.
+std::string PickGame(const std::string& games_dir);
+/// Muestra un error a pantalla completa hasta que se pulse +.
+void ShowFatal(const std::string& message);
+
+} // namespace Ounce::Hos
diff --git a/src/eden_ounce/launcher.cpp b/src/eden_ounce/launcher.cpp
new file mode 100644
index 0000000..f883d4e
--- /dev/null
+++ b/src/eden_ounce/launcher.cpp
@@ -0,0 +1,116 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Selector de juegos y pantalla de error en modo texto. Incluye <switch.h> y
+// NINGÚN header de Eden (ver horizon.h).
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <filesystem>
+#include <system_error>
+#include <vector>
+
+#include <switch.h>
+
+#include "eden_ounce/horizon.h"
+
+namespace fs = std::filesystem;
+
+namespace Ounce::Hos {
+namespace {
+
+bool HasGameExtension(const fs::path& p) {
+    std::string ext = p.extension().string();
+    std::transform(ext.begin(), ext.end(), ext.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return ext == ".nsp" || ext == ".xci" || ext == ".nca" || ext == ".nro" || ext == ".nso";
+}
+
+std::vector<fs::path> ListGames(const std::string& dir) {
+    std::vector<fs::path> games;
+    std::error_code ec;
+    fs::create_directories(dir, ec);
+    for (const auto& entry : fs::directory_iterator(dir, ec)) {
+        if (entry.is_regular_file(ec) && HasGameExtension(entry.path())) {
+            games.push_back(entry.path());
+        }
+    }
+    std::sort(games.begin(), games.end());
+    return games;
+}
+
+} // namespace
+
+std::string PickGame(const std::string& games_dir) {
+    // La consola usa el NWindow por defecto: hay que cerrarla antes de crear la superficie Vulkan.
+    PrintConsole* console = consoleInit(nullptr);
+    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+    PadState pad;
+    padInitializeDefault(&pad);
+
+    const auto games = ListGames(games_dir);
+    std::size_t selected = 0;
+    std::string result;
+    bool redraw = true;
+
+    while (appletMainLoop()) {
+        padUpdate(&pad);
+        const u64 down = padGetButtonsDown(&pad);
+
+        if (redraw) {
+            consoleClear();
+            std::printf("\x1b[1;1HEden para Switch 2 (eden-ounce) - experimental\n");
+            std::printf("Juegos en %s\n\n", games_dir.c_str());
+            if (games.empty()) {
+                std::printf("No hay juegos. Copia tus dumps (.nsp/.xci/.nca/.nro)\n");
+                std::printf("a esa carpeta y vuelve a abrir Eden.\n");
+            }
+            const std::size_t first = selected > 30 ? selected - 30 : 0;
+            for (std::size_t i = first; i < games.size() && i < first + 36; ++i) {
+                std::printf("%s %s\n", i == selected ? ">" : " ",
+                            games[i].filename().string().c_str());
+            }
+            std::printf("\x1b[44;1HA: iniciar   +: salir");
+            consoleUpdate(console);
+            redraw = false;
+        }
+
+        if (down & HidNpadButton_Plus) {
+            break;
+        }
+        if (!games.empty()) {
+            if (down & HidNpadButton_AnyDown) {
+                selected = (selected + 1) % games.size();
+                redraw = true;
+            } else if (down & HidNpadButton_AnyUp) {
+                selected = (selected + games.size() - 1) % games.size();
+                redraw = true;
+            } else if (down & HidNpadButton_A) {
+                result = games[selected].string();
+                break;
+            }
+        }
+    }
+    consoleExit(console);
+    return result;
+}
+
+void ShowFatal(const std::string& message) {
+    PrintConsole* console = consoleInit(nullptr);
+    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+    PadState pad;
+    padInitializeDefault(&pad);
+    std::printf("\x1b[1;1HEden no pudo arrancar:\n\n%s\n\nPulsa + para salir.", message.c_str());
+    consoleUpdate(console);
+    while (appletMainLoop()) {
+        padUpdate(&pad);
+        if (padGetButtonsDown(&pad) & HidNpadButton_Plus) {
+            break;
+        }
+        svcSleepThread(16'000'000);
+    }
+    consoleExit(console);
+}
+
+} // namespace Ounce::Hos
diff --git a/src/eden_ounce/main.cpp b/src/eden_ounce/main.cpp
new file mode 100644
index 0000000..f425361
--- /dev/null
+++ b/src/eden_ounce/main.cpp
@@ -0,0 +1,172 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// eden-ounce: frontend nativo de Eden para Switch 2 (KaiHEN + libounce).
+//
+// Arranque:
+//   1. hbloader lanza eden.nro (con o sin una ruta en argv[1]).
+//   2. Si no hay ruta, un selector de texto lista sdmc:/switch/eden/games.
+//   3. Se configura Eden para esta plataforma (Dynarmic sin fastmem, Vulkan/OunceVK,
+//      4 GiB de DRAM emulada) y se lanza el juego.
+//
+// Lo que el usuario necesita en la SD (dumpeado de SU consola, Eden no lo trae):
+//   sdmc:/switch/eden/keys/prod.keys  (+ title.keys para juegos con ticket)
+//   sdmc:/switch/eden/nand/system/... (firmware dumpeado, opcional pero recomendado)
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#include "common/fs/fs.h"
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "common/settings.h"
+#include "core/core.h"
+#include "core/cpu_manager.h"
+#include "core/file_sys/registered_cache.h"
+#include "core/file_sys/vfs/vfs_real.h"
+#include "core/hle/service/am/applet_manager.h"
+#include "core/hle/service/filesystem/filesystem.h"
+#include "core/loader/loader.h"
+#include "eden_ounce/emu_window_ounce.h"
+#include "eden_ounce/horizon.h"
+#include "input_common/main.h"
+#include "video_core/gpu.h"
+#include "video_core/rasterizer_interface.h"
+#include "video_core/renderer_base.h"
+
+namespace fs = std::filesystem;
+
+namespace {
+
+constexpr const char* kGamesDir = "sdmc:/switch/eden/games";
+
+/// Valores por defecto para esta plataforma. Se aplican antes de Initialize().
+void ConfigureForSwitch2() {
+    using namespace Settings;
+    // Sin NCE: kaiHEN no deja mapear el código del invitado como ejecutable en
+    // direcciones propias. Dynarmic recompila a la caché JIT de kaiHEN.
+    values.cpu_backend.SetValue(CpuBackend::Dynarmic);
+    // Sin mmap/aliasing no hay fastmem: Dynarmic usa la tabla de páginas.
+    values.cpuopt_fastmem.SetValue(false);
+    values.cpuopt_fastmem_exclusives.SetValue(false);
+    values.use_multi_core.SetValue(true);
+    // 4 GiB como la Switch 1; el pool de un juego de Switch 2 no da para más con Eden encima.
+    values.memory_layout_mode.SetValue(MemoryLayout::Memory_4Gb);
+
+    values.renderer_backend.SetValue(RendererBackend::Vulkan);
+    values.vsync_mode.SetValue(VSyncMode::Fifo);
+    values.resolution_setup.SetValue(ResolutionSetup::Res1X);
+    values.use_disk_shader_cache.SetValue(true);
+    values.use_asynchronous_gpu_emulation.SetValue(true);
+    // NVDEC por CPU necesita FFmpeg; desactivado hasta portarlo (los vídeos salen en negro).
+    values.nvdec_emulation.SetValue(NvdecEmulation::Off);
+    // Fase 1: sin backend de audio nativo todavía.
+    values.sink_id.SetValue(AudioEngine::Null);
+
+    values.use_docked_mode.SetValue(Ounce::Hos::IsDocked() ? ConsoleMode::Docked
+                                                           : ConsoleMode::Handheld);
+}
+
+bool CheckKeys(std::string& error) {
+    const auto keys = Common::FS::GetEdenPath(Common::FS::EdenPath::KeysDir) / "prod.keys";
+    std::error_code ec;
+    if (!fs::exists(keys, ec)) {
+        error = "Falta " + keys.string() +
+                "\nDumpea las claves de tu propia consola (p. ej. con Lockpick) y copialas ahi.";
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    // Que el juego emulado no se pause si el usuario abre el menu HOME un instante.
+    Ounce::Hos::SetNoSuspend();
+
+    Common::Log::Initialize();
+    Common::Log::Start();
+    LOG_INFO(Frontend, "eden-ounce arrancando");
+
+    std::string error;
+    if (!CheckKeys(error)) {
+        Ounce::Hos::ShowFatal(error);
+        return 1;
+    }
+
+    std::string filepath = argc > 1 ? std::string{argv[1]} : std::string{};
+    if (filepath.empty()) {
+        filepath = Ounce::Hos::PickGame(kGamesDir);
+        if (filepath.empty()) {
+            return 0;
+        }
+    }
+    LOG_INFO(Frontend, "Juego: {}", filepath);
+
+    ConfigureForSwitch2();
+
+    Core::System system{};
+    InputCommon::InputSubsystem input_subsystem{};
+
+    system.Initialize();
+    system.ApplySettings();
+
+    auto window = std::make_unique<EdenOunce::EmuWindowOunce>(input_subsystem, system);
+
+    system.SetContentProvider(std::make_unique<FileSys::ContentProviderUnion>());
+    system.SetFilesystem(std::make_shared<FileSys::RealVfsFilesystem>());
+    system.GetFileSystemController().CreateFactories(*system.GetFilesystem());
+    system.GetUserChannel().clear();
+
+    Service::AM::FrontendAppletParameters load_parameters{
+        .applet_id = Service::AM::AppletId::Application,
+    };
+    const Core::SystemResultStatus load_result = system.Load(*window, filepath, load_parameters);
+    if (load_result != Core::SystemResultStatus::Success) {
+        const u16 loader_id = u16(Core::SystemResultStatus::ErrorLoader);
+        std::string description = "Error de carga";
+        if (u16(load_result) > loader_id) {
+            description = Loader::GetResultStatusString(Loader::ResultStatus(u16(load_result) - loader_id));
+        }
+        LOG_CRITICAL(Frontend, "Load fallo: {} ({})", static_cast<u32>(load_result), description);
+        window.reset();
+        Ounce::Hos::ShowFatal("No se pudo cargar " + filepath + "\n" + description +
+                  "\nRevisa el log en sdmc:/switch/eden/log/");
+        return 1;
+    }
+
+    system.GPU().Start();
+    system.GetCpuManager().OnGpuReady();
+
+    if (Settings::values.use_disk_shader_cache.GetValue()) {
+        system.Renderer().ReadRasterizer()->LoadDiskResources(
+            system.GetApplicationProcessProgramID(), std::stop_token{},
+            [](VideoCore::LoadCallbackStage, size_t, size_t) {});
+    }
+
+    system.RegisterExitCallback([&window] { window->RequestClose(); });
+
+    void(system.Run());
+
+    // El emulador corre en sus propios hilos (núcleos de CPU, GPU, servicios);
+    // este hilo solo bombea entrada y eventos del applet.
+    while (window->PumpEvents()) {
+        Ounce::Hos::SleepNs(4'000'000); // 4 ms: suficiente para entrada a 240 Hz
+    }
+
+    if (system.IsPoweredOn()) {
+        system.Pause();
+        system.ShutdownMainProcess();
+    }
+    window.reset();
+    LOG_INFO(Frontend, "eden-ounce cerrado");
+    return 0;
+}
+
+#define VMA_IMPLEMENTATION
+#include "video_core/vulkan_common/vma.h"
diff --git a/src/eden_ounce/pad_input.cpp b/src/eden_ounce/pad_input.cpp
new file mode 100644
index 0000000..39641fd
--- /dev/null
+++ b/src/eden_ounce/pad_input.cpp
@@ -0,0 +1,99 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Mandos reales (vía horizon.h) -> VirtualGamepad de Eden. Sin <switch.h>.
+
+#include <array>
+
+#include "eden_ounce/horizon.h"
+#include "eden_ounce/pad_input.h"
+#include "input_common/drivers/virtual_gamepad.h"
+#include "input_common/main.h"
+
+namespace EdenOunce {
+namespace {
+
+namespace Btn = Ounce::Hos::Button;
+using VB = InputCommon::VirtualGamepad::VirtualButton;
+using VS = InputCommon::VirtualGamepad::VirtualStick;
+
+struct ButtonMap {
+    std::uint64_t hid;
+    VB virt;
+};
+
+// Mismo orden que EmulatedController::LoadVirtualGamepadParams.
+constexpr std::array<ButtonMap, 18> kButtons{{
+    {Btn::A, VB::ButtonA},          {Btn::B, VB::ButtonB},
+    {Btn::X, VB::ButtonX},          {Btn::Y, VB::ButtonY},
+    {Btn::StickL, VB::StickL},      {Btn::StickR, VB::StickR},
+    {Btn::L, VB::TriggerL},         {Btn::R, VB::TriggerR},
+    {Btn::ZL, VB::TriggerZL},       {Btn::ZR, VB::TriggerZR},
+    {Btn::Plus, VB::ButtonPlus},    {Btn::Minus, VB::ButtonMinus},
+    {Btn::Left, VB::ButtonLeft},    {Btn::Up, VB::ButtonUp},
+    {Btn::Right, VB::ButtonRight},  {Btn::Down, VB::ButtonDown},
+    {Btn::AnySL, VB::ButtonSL},     {Btn::AnySR, VB::ButtonSR},
+}};
+
+// Índice de Eden para el mando portátil (NpadIdType::Handheld).
+constexpr std::size_t kHandheldIndex = 8;
+
+std::array<Ounce::Hos::PadSnapshot, Ounce::Hos::MaxPads> g_snap{};
+std::array<std::uint64_t, Ounce::Hos::MaxPads> g_last_buttons{};
+std::uint64_t g_exit_combo_start = 0;
+
+void Feed(InputCommon::VirtualGamepad& gamepad, std::size_t player,
+          const Ounce::Hos::PadSnapshot& pad, std::uint64_t changed) {
+    for (const auto& map : kButtons) {
+        if (changed & map.hid) {
+            gamepad.SetButtonState(player, map.virt, (pad.buttons & map.hid) != 0);
+        }
+    }
+    gamepad.SetStickPosition(player, VS::Left, pad.lx, pad.ly);
+    gamepad.SetStickPosition(player, VS::Right, pad.rx, pad.ry);
+}
+
+} // namespace
+
+void InitializePads() {
+    Ounce::Hos::InitPads();
+}
+
+bool PollPads(InputCommon::InputSubsystem& input_subsystem) {
+    auto* gamepad = input_subsystem.GetVirtualGamepad();
+    Ounce::Hos::PollPads(g_snap);
+    bool exit_requested = false;
+
+    for (std::size_t i = 0; i < g_snap.size(); ++i) {
+        const auto& pad = g_snap[i];
+        if (!pad.connected) {
+            continue;
+        }
+        const std::uint64_t changed = pad.buttons ^ g_last_buttons[i];
+        g_last_buttons[i] = pad.buttons;
+
+        Feed(*gamepad, i, pad, changed);
+        if (i != 0) {
+            continue;
+        }
+        // El jugador 1 también maneja el mando "portátil" del juego, para que
+        // funcione igual en modo portátil y en dock.
+        Feed(*gamepad, kHandheldIndex, pad, changed);
+
+        // Atajo de salida: + y - a la vez durante 1 s.
+        constexpr std::uint64_t combo = Btn::Plus | Btn::Minus;
+        if ((pad.buttons & combo) == combo) {
+            const std::uint64_t now = Ounce::Hos::MonotonicNs();
+            if (g_exit_combo_start == 0) {
+                g_exit_combo_start = now;
+            } else if (now - g_exit_combo_start > 1'000'000'000ULL) {
+                exit_requested = true;
+            }
+        } else {
+            g_exit_combo_start = 0;
+        }
+    }
+    return exit_requested;
+}
+
+} // namespace EdenOunce
