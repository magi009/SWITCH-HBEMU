diff --git a/src/common/horizon/horizon_os.cpp b/src/common/horizon/horizon_os.cpp
new file mode 100644
index 0000000..c6f3073
--- /dev/null
+++ b/src/common/horizon/horizon_os.cpp
@@ -0,0 +1,38 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Único archivo de common/ que incluye <switch.h>. No incluir headers de Eden aquí.
+
+#include <bit>
+
+#include <switch.h>
+
+#include "common/horizon/horizon_os.h"
+
+namespace Common::Horizon {
+
+std::uint64_t TotalMemorySize() {
+    u64 value = 0;
+    svcGetInfo(&value, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+    return value;
+}
+
+std::uint64_t UsedMemorySize() {
+    u64 value = 0;
+    svcGetInfo(&value, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+    return value;
+}
+
+void SetCurrentThreadPriority(int horizon_priority) {
+    svcSetThreadPriority(threadGetCurHandle(), static_cast<u32>(horizon_priority));
+}
+
+int CoreCount() {
+    u64 mask = 0;
+    if (R_FAILED(svcGetInfo(&mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0)) || mask == 0) {
+        return 3; // lo mínimo que un juego tiene garantizado
+    }
+    return std::popcount(mask);
+}
+
+} // namespace Common::Horizon
diff --git a/src/common/horizon/horizon_os.h b/src/common/horizon/horizon_os.h
new file mode 100644
index 0000000..d318b82
--- /dev/null
+++ b/src/common/horizon/horizon_os.h
@@ -0,0 +1,32 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Puente mínimo hacia Horizon (libounce) para el código común de Eden.
+//
+// libnx y Eden no pueden compartir una unidad de compilación (libnx define
+// `struct Service`, `u128` y macros como BIT()). Este header solo usa tipos
+// estándar; la implementación (horizon_os.cpp) es la única que incluye <switch.h>.
+
+#pragma once
+
+#ifdef __SWITCH2__
+
+#include <cstdint>
+
+namespace Common::Horizon {
+
+/// Memoria total concedida al proceso (svcGetInfo TotalMemorySize).
+std::uint64_t TotalMemorySize();
+
+/// Memoria ya usada por el proceso (svcGetInfo UsedMemorySize).
+std::uint64_t UsedMemorySize();
+
+/// Cambia la prioridad del hilo actual. Horizon: número menor = más prioridad.
+void SetCurrentThreadPriority(int horizon_priority);
+
+/// Núcleos en los que puede correr el proceso.
+int CoreCount();
+
+} // namespace Common::Horizon
+
+#endif // __SWITCH2__
